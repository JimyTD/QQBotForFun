<?xml version="1.0" encoding="utf-8"?>
<tactics>
  <action>
    <name>AreaGatherCrateGeneric</name>
    <type>AutoRangedModify</type>
    <activeifeconomichcgatherpoint>1</activeifeconomichcgatherpoint>
    <modifyabstracttype>AbstractResourceCrate</modifyabstracttype>
    <maxrange>14</maxrange>
    <persistent>1</persistent>
    <donotignoredead>1</donotignoredead>
    <singleunit>0</singleunit>
    <modifytype>UnitResource</modifytype>
    <modifyamount>4.0</modifyamount>
    <modifytargetlimit>20</modifytargetlimit>
    <modelattachment>effects\ypack_auras\torpgatherpower.xml</modelattachment>
    <modelattachmentbone>bonethatdoesntexist</modelattachmentbone>
  </action>
  <action>
    <name>AutoGatherFoodMining</name>
    <type>AutoGather</type>
    <donotautogatherunlessgatheringtypes>
      <unittype>AbstractMine</unittype>
    </donotautogatherunlessgatheringtypes>
    <autogatherscalebygatherrate>1</autogatherscalebygatherrate>
    <persistent>1</persistent>
    <rate type="Food">0.200000</rate>
  </action>
  <action>
    <name>PolishMineGatherRateBonus</name>
    <type>AutoRangedModify</type>
    <maxrange>36</maxrange>
    <modifyabstracttype>LogicalTypeLandEconomy</modifyabstracttype>
    <persistent>1</persistent>
    <nostack>1</nostack>
    <nostackignorepuid>1</nostackignorepuid>
    <modifytype>MineGatherRate</modifytype>
    <modifymultiplier>1.15</modifymultiplier>
    <modelattachment>effects\ypack_auras\econpower.xml</modelattachment>
    <modelattachmentbone>bonethatdoesntexist</modelattachmentbone>
  </action>
  <action>
    <name>AutoGatherCoinFolwark</name>
    <type>AutoGather</type>
    <donotautogatherunlessgatheringtypes>
      <unittype>AbstractFolwark</unittype>
    </donotautogatherunlessgatheringtypes>
    <autogatherscalebygatherrate>1</autogatherscalebygatherrate>
    <persistent>1</persistent>
    <rate type="Gold">0.100000</rate>
  </action>
  <action>
    <name>SpawnCattle</name>
    <type>Spawn</type>
    <rate type="deSangaCattle">1.0</rate>
    <singleuse>1</singleuse>
    <animationrate>1</animationrate>
    <persistent>1</persistent>
  </action>
  <action>
    <name>MonasticGrangesFarmingRateBonus</name>
    <active>1</active>
    <type>AutoRangedModify</type>
    <maxrange>40</maxrange>
    <modifyabstracttype>AbstractVillager</modifyabstracttype>
    <persistent>1</persistent>
    <nostack>1</nostack>
    <nostackignorepuid>1</nostackignorepuid>
    <modifytype>FarmingGatherRate</modifytype>
    <modifymultiplier>1.15</modifymultiplier>
    <modelattachment>effects\ypack_auras\econpower.xml</modelattachment>
    <modelattachmentbone>bonethatdoesntexist</modelattachmentbone>
    <modifyrangeuselos>1</modifyrangeuselos>
  </action>
  <action>
    <name>MonasticGrangesFarmingRateBonusPriest</name>
    <active>1</active>
    <type>AutoRangedModify</type>
    <maxrange>40</maxrange>
    <modifyabstracttype>Priest</modifyabstracttype>
    <persistent>1</persistent>
    <nostack>1</nostack>
    <nostackignorepuid>1</nostackignorepuid>
    <modifytype>FarmingGatherRate</modifytype>
    <modifymultiplier>1.20</modifymultiplier>
    <modelattachment>effects\ypack_auras\econpower.xml</modelattachment>
    <modelattachmentbone>bonethatdoesntexist</modelattachmentbone>
    <modifyrangeuselos>1</modifyrangeuselos>
  </action>
  <action>
    <name>PigSpeedAura</name>
    <active>1</active>
    <type>AutoRangedModify</type>
    <maxrange>40</maxrange>
    <modifyabstracttype>Pig</modifyabstracttype>
    <persistent>1</persistent>
    <nostack>1</nostack>
    <nostackignorepuid>1</nostackignorepuid>
    <modifytype>Speed</modifytype>
    <modifymultiplier>3.00</modifymultiplier>
    <modifyrangeuselos>1</modifyrangeuselos>
  </action>
</tactics>