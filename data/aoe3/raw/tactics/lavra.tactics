    <action>AutoGatherXP</action>
    <action>EconomicAuraKM</action>
    <transition>
      <tactic>TrickleFood</tactic>
      <length>2</length>
      <exit>1</exit>
    </transition>
    <transition>
      <tactic>TrickleWood</tactic>
      <length>2</length>
      <exit>1</exit>
    </transition>
  </tactic>
  <tactic>TrickleFood
