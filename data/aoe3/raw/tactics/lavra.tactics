    <action>EconomicAuraKM</action>
    <transition>
      <tactic>TrickleCoin</tactic>
      <length>2</length>
      <exit>1</exit>
    </transition>
    <transition>
      <tactic>TrickleWood</tactic>
      <length>2</length>
      <exit>1</exit>
    </transition>
  </tactic>
  <tactic>TrickleWood
