    <populationscaling type="LogicalTypeLandEconomy">1.0</populationscaling>
  </action>
  <action>
    <name stringid="43296">AutoGatherWoodPopulation</name>
    <type>AutoGather</type>
    <persistent>1</persistent>
    <populationscaling type="LogicalTypeLandEconomy">1.0</populationscaling>
  </action>
  <action>
    <name stringid="43294">AutoGatherCoinPopulation</name>
